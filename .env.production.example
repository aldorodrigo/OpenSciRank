# ════════════════════════════════════════════════════════════════════
# .env.production.example — template para deploy en producción
# ════════════════════════════════════════════════════════════════════
# Copiar a `.env` en el servidor de producción y completar valores.
# NUNCA commitear el `.env` real al repo.
#
# Antes del primer deploy:
#   1. Generar APP_KEY: php artisan key:generate
#   2. Setear DB_PASSWORD con un valor seguro (NO usar "password")
#   3. Configurar Stripe LIVE keys (no test)
#   4. Configurar SES/SMTP real (no Mailpit)
#   5. Configurar dominio en APP_URL y SESSION_DOMAIN
# ════════════════════════════════════════════════════════════════════

APP_NAME="Editorial Standards Platform"
APP_ENV=production
APP_KEY=
# 🔴 CRÍTICO: APP_DEBUG=false en producción. Si queda true se exponen stack traces,
# paths del filesystem y variables de entorno en cualquier error 500.
APP_DEBUG=false
APP_URL=https://esp.u-cal.org

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_AR

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

# ── Logging ─────────────────────────────────────────────────────────
# En prod no usar "single" file — rota logs diariamente para evitar archivos gigantes.
LOG_CHANNEL=daily
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# Production debe ser "error" o "warning" — "debug" inunda el disco rápido.
LOG_LEVEL=error
LOG_DAILY_DAYS=14

# ── Base de datos ───────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=esp_production
DB_USERNAME=esp_user
# 🔴 CRÍTICO: contraseña fuerte (32+ caracteres aleatorios)
DB_PASSWORD=

# ── Sesión y cookies ────────────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
# Setear al dominio real (con punto inicial para subdominios)
SESSION_DOMAIN=.esp.u-cal.org
# 🔴 CRÍTICO: en HTTPS forzar secure cookies
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# ── Queue (Hostinger compartido: sync. VPS: database o redis) ───────
QUEUE_CONNECTION=sync

# ── Cache ───────────────────────────────────────────────────────────
CACHE_STORE=database
CACHE_PREFIX=esp_prod

# ── Broadcast (sin tiempo real por ahora — ver roadmap #43) ─────────
BROADCAST_CONNECTION=log

# ── Filesystem ──────────────────────────────────────────────────────
FILESYSTEM_DISK=local

# ── Mail ────────────────────────────────────────────────────────────
# En prod: Amazon SES o SMTP del proveedor. NO Mailpit.
MAIL_MAILER=smtp
MAIL_HOST=email-smtp.us-east-1.amazonaws.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@esp.u-cal.org"
MAIL_FROM_NAME="${APP_NAME}"

# 🔴 IMPORTANTE: configurar SPF, DKIM y DMARC en el DNS del dominio
# antes de enviar emails masivos, sino caen en spam de Gmail/Outlook.

# ── Stripe (claves LIVE — NO test) ──────────────────────────────────
STRIPE_KEY=pk_live_...
STRIPE_SECRET=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Livewire ────────────────────────────────────────────────────────
LIVEWIRE_TEMPORARY_FILE_UPLOAD_DISK=local

# ── Locale switcher ─────────────────────────────────────────────────
VITE_APP_NAME="${APP_NAME}"

# ── Telemetría / monitoring (opcional pero recomendado) ─────────────
# SENTRY_LARAVEL_DSN=
# LOG_SLACK_WEBHOOK_URL=
